{
  "name": "@ebbinghaus/extension",
  "displayName": "Hunter Plugin",
  "version": "0.0.1",
  "description": "Capture vocabulary words while reading and save them to Ebbinghaus",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv2",
    "build": "plasmo build",
    "build:chrome": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv2",
    "build:all": "plasmo build && plasmo build --target=firefox-mv2",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@ebbinghaus/shared": "workspace:*",
    "@plasmohq/storage": "1.15.0",
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.293",
    "@types/node": "22.13.13",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "2.1.8",
    "jsdom": "26.0.0",
    "typescript": "5.8.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ]
  },
  "manifest": {
    "host_permissions": [
      "https://api.dictionaryapi.dev/*",
      "http://localhost:3001/*",
      "http://localhost/*",
      "https://ebbinghaus-memory-gold.vercel.app/*"
    ],
    "permissions": [
      "activeTab",
      "storage",
      "alarms"
    ]
  }
}
